# Copy to .env.local and fill in. .env.local is gitignored. Mirror these in Vercel.

# Neon: console.neon.tech -> project -> Connect (pooled connection string)
DATABASE_URL=

# Gemini: https://aistudio.google.com/apikey  (enable billing for real candidate data)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Resend: leave blank until checkpoint B-2
RESEND_API_KEY=
RESEND_FROM=Kargo Hiring <onboarding@resend.dev>
# Your own inbox. When Resend can't email a candidate directly (no verified domain yet),
# the draft is sent here with the candidate's address and a ready-to-send Gmail link.
DRAFTS_TO=
# Optional safety net: only email these domains (comma-separated). Blank = any domain.
ALLOWED_RECIPIENT_DOMAIN=

